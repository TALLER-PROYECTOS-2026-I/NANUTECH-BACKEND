{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "API para gestión de camiones - Nanutech Backend",
  "Transform": [
    "AWS::Serverless-2016-10-31"
  ],
  "Parameters": {
    "StageName": {
      "Type": "String",
      "Default": "dev",
      "Description": "dev: 'dev' | testing: 'testing' | production: ''"
    },
    "DBHost": {
      "Type": "String",
      "Default": "database-demo.c56g84wquc58.us-east-2.rds.amazonaws.com"
    },
    "DBUser": {
      "Type": "String",
      "Default": "backend_user"
    },
    "DBPassword": {
      "Type": "String",
      "Default": "Backend123!",
      "NoEcho": true
    },
    "DBName": {
      "Type": "String",
      "Default": "postgres"
    },
    "DBPort": {
      "Type": "String",
      "Default": "5432"
    },
    "AuthProvider": {
      "Type": "String",
      "Default": "local"
    },
    "CognitoUserPoolId": {
      "Type": "String",
      "Default": ""
    },
    "CognitoClientId": {
      "Type": "String",
      "Default": ""
    },
    "SessionTimeoutSeconds": {
      "Type": "String",
      "Default": "7200"
    },
    "AuthTokenSecret": {
      "Type": "String",
      "Default": "nanutech-local-auth-secret",
      "NoEcho": true
    },
    "DBSslEnabled": {
      "Type": "String",
      "Default": "true"
    },
    "PrivateSubnets": {
      "Type": "CommaDelimitedList",
      "Description": "IDs de las subredes privadas para las Lambdas"
    },
    "LambdaSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "ID del Security Group para las Lambdas"
    },
    "FrontendUrl": {
      "Type": "String",
      "Description": "URL del Frontend de Amplify (Testing o Producción)",
      "Default": "http://localhost:3000"
    }
  },
  "Globals": {
    "Function": {
      "Timeout": 30,
      "MemorySize": 512,
      "Runtime": "nodejs20.x",
      "Architectures": [
        "x86_64"
      ],
      "Environment": {
        "Variables": {
          "NODE_ENV": "StageName",
          "DB_HOST": "DBHost",
          "DB_USER": "DBUser",
          "DB_PASSWORD": "DBPassword",
          "DB_NAME": "DBName",
          "DB_PORT": "DBPort",
          "AWS_NODEJS_CONNECTION_REUSE_ENABLED": "1",
          "NODE_OPTIONS": "--enable-source-maps",
          "AUTH_PROVIDER": "AuthProvider",
          "COGNITO_USER_POOL_ID": "CognitoUserPoolId",
          "COGNITO_CLIENT_ID": "CognitoClientId",
          "SESSION_TIMEOUT_SECONDS": "SessionTimeoutSeconds",
          "AUTH_TOKEN_SECRET": "AuthTokenSecret",
          "DB_SSL_ENABLED": "DBSslEnabled"
        }
      },
      "LoggingConfig": {
        "LogFormat": "JSON"
      },
      "Tags": {
        "Environment": "StageName",
        "Proyecto": "Nanutech-Backend"
      },
      "Tracing": "Active",
      "VpcConfig": {
        "SecurityGroupIds": [
          "LambdaSecurityGroup"
        ],
        "SubnetIds": "PrivateSubnets"
      }
    }
  },
  "Resources": {
    "NanutechApi": {
      "Type": "AWS::Serverless::Api",
      "Properties": {
        "Name": "nanutech-api-${StageName}",
        "StageName": "StageName",
        "Cors": {
          "AllowMethods": "'GET,POST,PUT,PATCH,DELETE,OPTIONS'",
          "AllowHeaders": "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'",
          "AllowOrigin": "'${FrontendUrl}'"
        },
        "TracingEnabled": true,
        "Tags": {
          "Environment": "StageName",
          "Proyecto": "Nanutech-Backend"
        }
      }
    },
    "CamionFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "FunctionName": "${StageName}-camiones",
        "CodeUri": ".",
        "Handler": "src/functions/camion-services/camionHandler.handler",
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          {
            "VPCAccessPolicy": {}
          }
        ],
        "Environment": {
          "Variables": {
            "LOG_LEVEL": "debug"
          }
        },
        "Events": {
          "GetCamiones": {
            "Type": "Api",
            "Properties": {
              "RestApiId": "NanutechApi",
              "Path": "/camiones",
              "Method": "GET"
            }
          },
          "GetCamionById": {
            "Type": "Api",
            "Properties": {
              "RestApiId": "NanutechApi",
              "Path": "/camiones/{id}",
              "Method": "GET"
            }
          },
          "CreateCamion": {
            "Type": "Api",
            "Properties": {
              "RestApiId": "NanutechApi",
              "Path": "/camiones",
              "Method": "POST"
            }
          },
          "GetPanelCamiones": {
            "Type": "Api",
            "Properties": {
              "RestApiId": "NanutechApi",
              "Path": "/camiones/panel",
              "Method": "GET"
            }
          },
          "ExportCamionesCsv": {
            "Type": "Api",
            "Properties": {
              "RestApiId": "NanutechApi",
              "Path": "/camiones/exportar/csv",
              "Method": "GET"
            }
          }
        },
        "Tags": {
          "Environment": "StageName",
          "Servicio": "camion"
        }
      },
      "Metadata": {
        "BuildMethod": "esbuild",
        "BuildProperties": {
          "Minify": false,
          "Target": "es2022",
          "Sourcemap": true,
          "EntryPoints": [
            "src/functions/camion-services/camionHandler.mjs"
          ]
        }
      }
    },
